{
  "name": "aws-ai-practitioner-flashcards",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "types": "json2ts -i schema/card.schema.json -o src/types/card.ts && json2ts -i schema/glossary.schema.json -o src/types/glossary.ts",
    "validate": "tsx scripts/validate.ts"
  },
  "dependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": ">=4.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": ">=4.0.0",
    "ajv": "^8.0.0",
    "ajv-formats": ">=3.0.0",
    "json-schema-to-typescript": ">=14.0.0",
    "tailwindcss": ">=4.0.0",
    "tsx": ">=4.0.0",
    "typescript": "^5.0.0",
    "vite": ">=5.0.0"
  }
}
